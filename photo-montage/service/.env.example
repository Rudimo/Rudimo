# --- обязательное ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- опционально: прямой Gemini (нужен ключ проекта с включённым биллингом) ---
# GEMINI_API_KEY=AIza... или AQ....

# --- защита API (ОБЯЗАТЕЛЬНО: без токена сервис не стартует) ---
SERVICE_TOKEN=сгенерируй: openssl rand -hex 32
# только для локальной разработки без токена:
# ALLOW_NO_AUTH=1

# --- тюнинг ---
# WORKERS=4                # параллельных генераций
# MAX_UPLOAD_MB=15
# MAX_TASKS_PER_JOB=24     # комбинаций в одной задаче
# MAX_PENDING_TASKS=96     # backpressure: 429 при переполнении очереди
# PROVIDER=openrouter      # провайдер по умолчанию
# OPENROUTER_MODEL=google/gemini-3-pro-image-preview
# GEMINI_MODEL=gemini-3-pro-image-preview
# DATA_DIR=/data
