# --- обязательное ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- опционально: прямой Gemini (нужен ключ проекта с включённым биллингом) ---
# GEMINI_API_KEY=AIza... или AQ....

# --- защита API (рекомендуется для прода) ---
# SERVICE_TOKEN=длинная-случайная-строка

# --- тюнинг ---
# WORKERS=4                # параллельных генераций
# MAX_UPLOAD_MB=15
# MAX_TASKS_PER_JOB=24
# PROVIDER=openrouter      # провайдер по умолчанию
# OPENROUTER_MODEL=google/gemini-3-pro-image-preview
# GEMINI_MODEL=gemini-3-pro-image-preview
# DATA_DIR=/data
